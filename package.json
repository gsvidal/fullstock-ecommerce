{
  "name": "fullstock-spa-steps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "react-router typegen && tsc -b --noEmit",
    "preview": "npm run build && npm run start",
    "start": "react-router-serve ./build/server/index.js",
    "db:new": "dbmate new",
    "db:up": "dbmate up",
    "db:migrate": "dbmate migrate",
    "db:rollback": "dbmate rollback",
    "db:status": "dbmate status",
    "db:drop": "dbmate drop",
    "db:reset": "npm run db:drop && npm run db:up"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "bcrypt": "^6.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dbmate": "^2.35.1",
    "drizzle-orm": "1.0.0-rc.4",
    "isbot": "^5",
    "pg": "^8.23.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.81.0",
    "react-router": "^8.1.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
